PORT=3000
NODE_ENV=production
APP_VERSION=4.1.0
# Optional Git commit or deployment identifier displayed beside the version.
BUILD_REVISION=

# Attach NEO DB and use the PostgreSQL connection string it provides.
DATABASE_URL=postgresql://user:password@database-host:5432/database_name
DATABASE_AUTO_MIGRATE=true

# Choose a long random value. It protects add, import, upload, and delete actions.
ADMIN_TOKEN=replace-with-a-long-random-secret

# S3-compatible Object Storage for private book-cover files.
S3_ENDPOINT=https://your-object-storage-endpoint.example.com
S3_REGION=us-east-1
S3_BUCKET=book-summary-covers
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_FORCE_PATH_STYLE=true
MAX_PDF_BYTES=26214400
